# Copia este archivo a .env y llena los valores reales. Nunca subas .env a git.

# Cadena larga y aleatoria (ej: genera una con `openssl rand -hex 32`)
SESSION_SECRET=

# Ruta al archivo de base de datos SQLite (déjalo así para empezar)
DATABASE_PATH=./db/gruponar.db

# Solo para crear el primer usuario admin con `npm run seed`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# DocuSign (dejar vacío hasta que tengas cuenta developer) — ver routes/docusign.js
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=

NODE_ENV=development
PORT=3000

# Solo necesario si el frontend NO se sirve desde /public de este servidor
# (ej. lo sigues abriendo como artifact de claude.ai). Pon la URL exacta,
# ej: https://claude.site/artifacts/xxxxx — si no la sabes, deja vacío y
# sirve el frontend desde /public en vez de esto.
FRONTEND_ORIGIN=
