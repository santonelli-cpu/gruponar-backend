{
  "key": "lpr-individual-en",
  "label": "LPR Luxury — Customer Identification Record (Individual, English)",
  "docxFile": "lpr-individual-en.docx",
  "company": "lpr",
  "partyKind": "individual",
  "language": "en",
  "sections": [
    {
      "title": "Type of person",
      "fields": [
        { "id": "tipoPersona", "label": "Type of person", "type": "radio",
          "options": [
            { "value": "mexicana", "label": "Mexican natural person" },
            { "value": "extranjera_residente", "label": "Natural person resident alien" },
            { "value": "extranjera_visitante", "label": "Natural person foreign visitor" }
          ], "required": true },
        { "id": "numeroExpediente", "label": "File number (FME-___, assigned by your coordinator)", "type": "text" }
      ]
    },
    {
      "title": "Identification",
      "fields": [
        { "id": "nombre", "label": "Full name (as shown on official identification)", "type": "text", "required": true, "prefillFrom": "partyName" },
        { "id": "fechaNacimiento", "label": "Date of birth", "type": "date", "required": true },
        { "id": "lugarNacimiento", "label": "Birthplace (city and country)", "type": "text", "required": true },
        { "id": "nacionalidad", "label": "Nationality", "type": "text", "required": true },
        { "id": "condicionEstanciaMexico", "label": "Legal status of stay in Mexico (optional, if applicable)", "type": "text" },
        { "id": "lugarResidencia", "label": "Place of residence", "type": "text", "required": true },
        { "id": "ocupacion", "label": "Occupation", "type": "text", "required": true }
      ]
    },
    {
      "title": "Contact",
      "fields": [
        { "id": "telefonoCasa", "label": "Home phone number (including international code)", "type": "text" },
        { "id": "telefonoOficina", "label": "Office phone number (including international code)", "type": "text" },
        { "id": "telefonoCelular", "label": "Cell phone number (including international code)", "type": "text", "required": true },
        { "id": "correoElectronico", "label": "E-mail address", "type": "email", "required": true, "prefillFrom": "partyEmail" }
      ]
    },
    {
      "title": "Identification document",
      "fields": [
        { "id": "tipoDocumento", "label": "Document type you identify yourself with", "type": "text", "required": true },
        { "id": "autoridadEmisora", "label": "Issuing authority", "type": "text", "required": true },
        { "id": "numeroIdentificacion", "label": "Identification number", "type": "text", "required": true },
        { "id": "fechaExpedicionId", "label": "Date issued", "type": "date", "required": true },
        { "id": "fechaVencimientoId", "label": "Expiration date", "type": "date", "required": true }
      ]
    },
    {
      "title": "Address",
      "fields": [
        { "id": "domicilioMexico", "label": "Home address in Mexico (optional, if applicable)", "type": "textarea" },
        { "id": "domicilioExtranjero", "label": "Private home abroad address (optional, if applicable)", "type": "textarea" }
      ]
    },
    {
      "title": "Tax identifiers",
      "fields": [
        { "id": "curp", "label": "CURP (optional — Mexicans and residents only, 18 characters)", "type": "text", "maxLength": 18 },
        { "id": "rfc", "label": "RFC (optional — Mexicans and residents only, 13 characters)", "type": "text", "maxLength": 13 },
        { "id": "numeroSeguridadSocial", "label": "Social Security number or government accreditation number of citizenship (optional — aliens only)", "type": "text" }
      ]
    },
    {
      "title": "Beneficiary owner",
      "fields": [
        { "id": "tieneDuenoBeneficiario", "label": "Do you have knowledge of the existence of a beneficiary owner?", "type": "radio",
          "options": [ { "value": "si", "label": "Yes" }, { "value": "no", "label": "No" } ], "required": true },
        { "id": "tipoDuenoBeneficiario", "label": "Type of beneficiary owner (only if you answered Yes above)", "type": "radio",
          "options": [
            { "value": "persona_fisica_mx", "label": "Natural person or Mexican foreign resident" },
            { "value": "persona_fisica_visitante", "label": "Natural person foreign visitor" },
            { "value": "persona_moral_mx", "label": "Mexican legal entity" },
            { "value": "persona_moral_extranjera", "label": "Foreign legal entity" },
            { "value": "fideicomiso", "label": "Trust" }
          ] }
      ]
    },
    {
      "title": "Declaration",
      "fields": [
        { "id": "fechaFirma", "label": "Date", "type": "date", "required": true }
      ]
    }
  ]
}
